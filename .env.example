# Copy to .env and fill in. `make env` generates random secrets for local use.

# Postgres (Airflow metadata + MLflow backend)
POSTGRES_USER=jmi
POSTGRES_PASSWORD=change-me

# S3-compatible data lake (SeaweedFS)
S3_ACCESS_KEY=jmi
S3_SECRET_KEY=change-me-min-8-chars
S3_ENDPOINT_URL=http://s3:8333
S3_BUCKET_RAW=raw
S3_BUCKET_PROCESSED=processed

# ClickHouse (DWH)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_USER=jmi
CLICKHOUSE_PASSWORD=change-me

# Qdrant (vector store)
QDRANT_URL=http://qdrant:6333

# Airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# LLM / embeddings via Ollama on the Windows host (OpenAI-compatible API)
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3:30b
EMBEDDING_MODEL=bge-m3

# Sources
HTTP_USER_AGENT=job-market-insights/0.1 (you@example.com)
HH_ENABLED=false
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_QUERIES=data engineer,python,devops,machine learning
HIMALAYAS_ENABLED=true
HIMALAYAS_QUERIES=data engineer,python developer,devops engineer,machine learning engineer
HIMALAYAS_MAX_PAGES=5

# Optional alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
